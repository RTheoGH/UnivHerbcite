[sub_resource type="Shader" id="Shader_tqkkf"]
code = "
// NOTE: Shader automatically converted from Godot Engine 4.5.stable's PanoramaSkyMaterial.

shader_type sky;

uniform sampler2D source_panorama : filter_linear, source_color, hint_default_black;
uniform sampler2D uv_offset : filter_linear, repeat_enable;

uniform float exposure : hint_range(0, 128) = 1.0;

void sky() {
	
	vec2 noise = (texture(uv_offset, SKY_COORDS + (TIME / 400.0)).rg) / 10.0;
	
	vec2 new_uv = SKY_COORDS + noise;
	
	COLOR = texture(source_panorama, new_uv).rgb * exposure;
	//COLOR.xy = noise * 10.0;
}
"

