[sub_resource type="GDScript" id="GDScript_0ufl0"]
script/source = "extends Node3D

func _on_interactable_on_interaction_signal() -> void:
	Global.text_alert.show_alert(\"La porte ne s'ouvre pas de ce coté...\")
	$AnimationPlayer.play(\"fail_open\")

func _on_interactable_2_on_interaction_signal() -> void:
	Global.text_alert.show_alert(\"La porte du S-pace s'est ouverte\")
	$AnimationPlayer.play(\"open\")
	$Interactable2.queue_free()
	$Interactable.queue_free()
"

