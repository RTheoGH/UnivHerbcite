[sub_resource type="GDScript" id="GDScript_75rwc"]
resource_name = "door_labo"
script/source = "extends MeshInstance3D

var verrouillee = true

#func _ready() -> void:
	#Global.player_inventory.add_item(load(\"res://assets/game_resources/items/potions/potion_jaune.tres\"))

func _on_interactable_on_interaction_signal() -> void:
	if verrouillee:
		Global.text_alert.show_alert(\"La porte est verrouillée par un cadenas.\")
	else:
		pass #Tom fais ta magie


func _on_static_body_3d_on_interaction_signal() -> void:
	print(Global.inv_current_slot)
	if Global.player_inventory.items.size()-1 >= Global.inv_current_slot\\
	 and Global.player_inventory.items[Global.inv_current_slot].type == InventoryItem.InventoryItemType.POTION_ROUGE:
		Global.player_inventory.remove_item(Global.player_inventory.items[Global.inv_current_slot])
		$\"MeshInstance3D\".queue_free()
		verrouillee = false
	else:
		Global.text_alert.show_alert(\"Il faudrait quelque chose pour retirer le cadenas.\")
"

