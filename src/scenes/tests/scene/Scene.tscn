[sub_resource type="GDScript" id="GDScript_v5phb"]
resource_name = "lore_z4"
script/source = "extends Control

var one_time: bool = false

var sun : MeshInstance3D
var we : WorldEnvironment
var music = AudioStreamPlayer2D

func _ready() -> void:
	var scene = get_parent().get_parent()
	sun = scene.get_node(\"Map2\").get_node(\"MeshInstance3D\")
	we = scene.get_node(\"Map2\").get_node(\"WorldEnvironment\")
	music = scene.get_node(\"Musique\")

func _on_visibility_changed() -> void:
	if not visible and !one_time:
		Global.narrate(\"L'expérience\",\"J'ai trouvé la note d'un scientifique qui décrit une expérience à propos d'un 'noyau' et d'une contre-mesure. Je n'ai pas vu de 'noyau' dans ce laboratoire. Ne me dites pas que...\")
		one_time = true
		
		while Global.isPaused:
			await get_tree().process_frame
		
		var tween_sun = create_tween()
		tween_sun.tween_property(sun, \"scale\", Vector3(1.0,1.0,1.0), 20.0)
		
		var target = {
			\"pitch\": 0.8,
			\"volume\": -3.0
		}
		#var target_pitch = 0.8
		#var target_volume = -3.0
		
		var tween_chaos = create_tween()
		tween_chaos.tween_method(func(_value):
			if randi() % 20 == 0:
				target[\"pitch\"] = 0.8 + randf_range(-0.02, 0.02) 
				target[\"volume\"] = -3.0 + randf_range(-0.5, 0.5)
			
			music.pitch_scale = lerp(music.pitch_scale, target[\"pitch\"], 0.05)
			music.volume_db = lerp(music.volume_db, target[\"volume\"], 0.05)
		, 0.0, 1.0, 20.0)
		
		var ciel = we.environment.sky
		if ciel and ciel.sky_material:
			var csm = ciel.sky_material as ShaderMaterial
			
			var start_red = csm.get_shader_parameter(\"red_deg\")
			var start_exp = csm.get_shader_parameter(\"exposure\")
			
			var tween_shader = create_tween()
			tween_shader.tween_method(func(value):
				csm.set_shader_parameter(\"red_deg\", lerp(start_red, -6.0, value))
				csm.set_shader_parameter(\"exposure\", lerp(start_exp, 3.0, value))
			, 0.0, 1.0, 20.0)
		
		await tween_sun.finished
		await get_tree().create_timer(5.0).timeout
		Global.narrate(\"L'expérience\", \"Je ferais mieux de me dépecher.\")
"

