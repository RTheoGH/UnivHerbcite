offset_right = 365.0
offset_bottom = 326.0
theme_override_colors/default_color = Color(0.18717614, 0.18717614, 0.18717614, 1)
theme_override_font_sizes/normal_font_size = 11
bbcode_enabled = true
text = "[fill]C'est vraiment le point de vue parfait pour les observer ! Rester dans l'ombre du bâtiment 5 pour les prendre en photo sous la lumière du soleil. En plus de ça, j'ai ma petite routine pour les photos : d'abord je regarde les [color=dark_red]abeilles[/color] butiner les plantes, puis je regarde s'il y a un [color=darkred]écureuil[/color] près des arbres et enfin j'observe l'arbre esseulé au cas où un de ces [color=dark_red]étourneaux[/color] se pose dessus. D'ailleurs je crois bien que certains gars du labo chargés de l'entretien de la [color=dark_red]forêt devant le S-pace[/color] m'ont piqué ma routine, ils font carrément fuir les animaux !"

