[sub_resource type="GDScript" id="GDScript_xfcej"]
resource_name = "blocus_zone_3"
script/source = "extends MeshInstance3D

func _on_interactable_on_interaction_signal() -> void:
	if Global.player_inventory.items.size()-1 <= Global.inv_current_slot\\
	 and Global.player_inventory.items[Global.inv_current_slot].type == InventoryItem.InventoryItemType.POTION_VIOLETTE:
		Global.player_inventory.remove_item(Global.player_inventory.ittems[Global.inv_current_slot])
		queue_free()
"

